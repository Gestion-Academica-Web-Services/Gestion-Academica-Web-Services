    "monto_maximo_financiable": 3500000.0,
    "plazo_maximo_meses": 6
  },
  "success": true
}
```

- [ ] Si el resultado no es favorable por capacidad de pago insuficiente, el backend retorna:

```json
{
  "mensaje": "Evaluación completada: No cumple con la capacidad de pago requerida",
  "data": {
    "evaluacion_id": "EVAL-2026-090",
    "usuario_id": 101,
    "resultado_viabilidad": "NO_VIABLE",
    "monto_maximo_financiable": 0.0
  },
  "success": false
}
```

